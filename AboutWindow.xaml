<Window x:Class="Win11IsoBypass.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:sys="clr-namespace:System;assembly=mscorlib"
        Title="Sobre o Windows ISO Customizer"
        Icon="/Win11IsoBypass;component/Assets/WindowsIsoCustomizer.ico"
        Width="500" Height="350" ResizeMode="NoResize" WindowStartupLocation="CenterOwner"
        Background="{StaticResource PageBackground}">
    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel Orientation="Horizontal">
            <Image Source="/Win11IsoBypass;component/Assets/WindowsIsoCustomizer-96.png" Width="62" Height="62" />
            <StackPanel Margin="16,2,0,0">
                <TextBlock Text="Windows ISO Customizer" FontSize="21" FontFamily="Segoe UI Semibold" />
                <TextBlock Text="Freeware" Foreground="#6EE7B7" FontFamily="Segoe UI Semibold" Margin="0,3,0,0" />
            </StackPanel>
        </StackPanel>
        <StackPanel Grid.Row="1" Margin="0,24,0,0">
            <TextBlock Text="Aplicativo gratuito para personalizar mídias de instalação do Windows com arquivos de resposta e opções de compatibilidade." TextWrapping="Wrap" Foreground="{StaticResource TextSecondary}" />
            <TextBlock Text="Desenvolvido por Aguinaldo Liesack Baptistini" Margin="0,18,0,0" />
            <TextBlock Margin="0,10,0,0">
                <Run Text="GitHub: " Foreground="{StaticResource TextSecondary}" />
                <Hyperlink NavigateUri="https://github.com/hawkinf/Win11IsoBypass" RequestNavigate="Github_RequestNavigate" Foreground="#A398FF">github.com/hawkinf/Win11IsoBypass</Hyperlink>
            </TextBlock>
        </StackPanel>
        <Button Grid.Row="2" Content="Fechar" Width="100" HorizontalAlignment="Right" Click="Close_Click" />
    </Grid>
</Window>
