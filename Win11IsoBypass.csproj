<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AssemblyName>Win11IsoBypass</AssemblyName>
    <RootNamespace>Win11IsoBypass</RootNamespace>
    <Version>1.0.0</Version>
    <ApplicationIcon>Assets\WindowsIsoCustomizer.ico</ApplicationIcon>
    <Product>Windows ISO Customizer</Product>
    <Description>Personalize mídias de instalação do Windows com arquivos de resposta e bypasses.</Description>
    <Company>Windows ISO Customizer</Company>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Assets\WindowsIsoCustomizer.ico" />
    <Resource Include="Assets\WindowsIsoCustomizer-96.png" />
    <Resource Include="Assets\WindowsIsoCustomizer-256.png" />
    <Resource Include="Assets\WindowsIsoCustomizer.svg" />
    <EmbeddedResource Include="Assets\oscdimg.exe" LogicalName="Win11IsoBypass.oscdimg.exe" />
  </ItemGroup>

</Project>
