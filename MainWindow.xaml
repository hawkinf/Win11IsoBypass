<Window x:Class="Win11IsoBypass.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Windows ISO Customizer" Icon="/Win11IsoBypass;component/Assets/WindowsIsoCustomizer.ico" Height="790" Width="960" MinHeight="700" MinWidth="820"
        WindowStartupLocation="CenterScreen" Background="{StaticResource PageBackground}">
    <Window.Resources>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource CardBackground}" />
            <Setter Property="BorderBrush" Value="{StaticResource CardBorder}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="14" />
            <Setter Property="Padding" Value="22" />
            <Setter Property="Margin" Value="0,0,0,16" />
        </Style>
        <Style x:Key="BrowseButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="#27334E" />
            <Setter Property="Padding" Value="16,9" />
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#0E1528" BorderBrush="{StaticResource CardBorder}" BorderThickness="0,0,0,1" Padding="32,22">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border Width="48" Height="48" CornerRadius="12" Background="{StaticResource Accent}" Margin="0,0,16,0" Padding="5">
                    <Image Source="/Win11IsoBypass;component/Assets/WindowsIsoCustomizer-96.png" Stretch="Uniform" />
                </Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="Windows ISO Customizer" FontFamily="Segoe UI Semibold" FontSize="23" />
                    <TextBlock Text="Insira um unattend.xml e personalize a mídia de instalação" Foreground="{StaticResource TextSecondary}" Margin="0,3,0,0" />
                </StackPanel>
                <Border Grid.Column="2" Background="#173B35" CornerRadius="12" Padding="12,6" VerticalAlignment="Center">
                    <TextBlock Text="EXECUTANDO COMO ADMIN" Foreground="#6EE7B7" FontSize="11" FontFamily="Segoe UI Semibold" />
                </Border>
            </Grid>
        </Border>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="32,24">
            <StackPanel MaxWidth="896">
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="1. Arquivos" FontFamily="Segoe UI Semibold" FontSize="17" Margin="0,0,0,16" />
                        <TextBlock Text="ISO original do Windows (7, 8.1, 10, 11 ou compatível)" Foreground="{StaticResource TextSecondary}" Margin="0,0,0,6" />
                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <TextBox x:Name="SourceIsoTextBox" IsReadOnly="True" VerticalContentAlignment="Center" />
                            <Button Grid.Column="1" Content="Escolher ISO" Style="{StaticResource BrowseButton}" Margin="10,0,0,0" Click="ChooseSource_Click" />
                        </Grid>
                        <TextBlock Text="Salvar nova ISO como" Foreground="{StaticResource TextSecondary}" Margin="0,0,0,6" />
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <TextBox x:Name="OutputIsoTextBox" IsReadOnly="True" VerticalContentAlignment="Center" />
                            <Button Grid.Column="1" Content="Escolher destino" Style="{StaticResource BrowseButton}" Margin="10,0,0,0" Click="ChooseOutput_Click" />
                        </Grid>
                    </StackPanel>
                </Border>

                <Border x:Name="ImageSelectionCard" Style="{StaticResource Card}" Visibility="Collapsed">
                    <StackPanel>
                        <TextBlock Text="Imagens a incluir no ISO" FontFamily="Segoe UI Semibold" FontSize="17" />
                        <TextBlock x:Name="ImageSelectionHint" Text="Todas as edições encontradas estão selecionadas." Foreground="{StaticResource TextSecondary}" Margin="0,4,0,10" TextWrapping="Wrap" />
                        <ItemsControl x:Name="ImageOptionsList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}" Margin="0,5,0,5">
                                        <StackPanel>
                                            <TextBlock Text="{Binding DisplayName}" FontFamily="Segoe UI Semibold" />
                                            <TextBlock Text="{Binding DisplayDetails}" Foreground="{StaticResource TextSecondary}" FontSize="11" Margin="0,2,0,0" />
                                        </StackPanel>
                                    </CheckBox>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Arquivo de resposta (opcional)" FontFamily="Segoe UI Semibold" FontSize="17" />
                        <TextBlock Text="Use um unattend.xml próprio. O conteúdo será copiado sem alterações." Foreground="{StaticResource TextSecondary}" Margin="0,4,0,12" />
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <TextBox x:Name="CustomUnattendTextBox" IsReadOnly="True" VerticalContentAlignment="Center" />
                            <Button Grid.Column="1" Content="Escolher XML" Style="{StaticResource BrowseButton}" Margin="10,0,0,0" Click="ChooseUnattend_Click" />
                        </Grid>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="220" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <TextBlock Text="Colocar em:" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center" Margin="0,0,12,0" />
                            <ComboBox x:Name="UnattendPlacementComboBox" Grid.Column="1" SelectedIndex="2" Padding="8,6" Background="#0B1223" Foreground="{StaticResource TextPrimary}" BorderBrush="{StaticResource CardBorder}">
                                <ComboBoxItem Content="Raiz (Autounattend.xml)" />
                                <ComboBoxItem Content="sources\\Autounattend.xml" />
                                <ComboBoxItem Content="Windows\\Panther (instalação)" />
                                <ComboBoxItem Content="Raiz + Windows\\Panther" />
                                <ComboBoxItem Content="Todos os locais" />
                            </ComboBox>
                            <TextBlock Grid.Column="2" Text="Panther é aplicado ao Windows instalado; raiz é usada no boot." Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center" Margin="14,0,0,0" />
                        </Grid>
                        <CheckBox x:Name="ApplyToInstallImagesCheckBox" Content="Aplicar também diretamente dentro de install.wim/install.esd" IsChecked="False" ToolTip="Opcional e mais pesado. No WIM, a alteração é feita diretamente. No ESD, a mídia usa a estrutura $OEM$ para entregar o arquivo ao Windows instalado." />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="2. Bypass opcional do Windows 11" FontFamily="Segoe UI Semibold" FontSize="17" />
                        <TextBlock Text="Deixe desmarcado para ISOs do Windows 7, 8.1, 10 ou outras versões." Foreground="{StaticResource TextSecondary}" Margin="0,4,0,10" />
                        <CheckBox x:Name="Win11BypassCheckBox" Content="Aplicar bypass de requisitos do Windows 11" IsChecked="False" Checked="Win11BypassCheckBox_Changed" Unchecked="Win11BypassCheckBox_Changed" />
                        <WrapPanel x:Name="BypassOptionsPanel" IsEnabled="False" Opacity="0.48">
                            <CheckBox x:Name="TpmCheckBox" Content="TPM 2.0" IsChecked="True" />
                            <CheckBox x:Name="SecureBootCheckBox" Content="Secure Boot" IsChecked="True" />
                            <CheckBox x:Name="RamCheckBox" Content="Memória RAM" IsChecked="True" />
                            <CheckBox x:Name="CpuCheckBox" Content="Processador" IsChecked="True" />
                            <CheckBox x:Name="StorageCheckBox" Content="Armazenamento" IsChecked="True" />
                        </WrapPanel>
                        <Border Background="#332C19" BorderBrush="#66552A" BorderThickness="1" CornerRadius="8" Padding="13" Margin="0,10,0,0">
                            <TextBlock TextWrapping="Wrap" Foreground="#F5D67B"><Run FontFamily="Segoe UI Semibold" Text="Atenção: "/><Run Text="o Windows 11 ficará sem suporte oficial nesse hardware. O bypass não adiciona instruções ausentes ao processador; PCs 32-bit ou muito antigos ainda podem não iniciar." /></TextBlock>
                        </Border>
                    </StackPanel>
                </Border>

                <Border x:Name="ProgressCard" Style="{StaticResource Card}" Visibility="Collapsed">
                    <StackPanel>
                        <Grid Margin="0,0,0,10">
                            <TextBlock x:Name="StatusText" Text="Preparando..." FontFamily="Segoe UI Semibold" FontSize="15" />
                            <TextBlock x:Name="PercentText" Text="" HorizontalAlignment="Right" Foreground="{StaticResource TextSecondary}" />
                        </Grid>
                        <ProgressBar x:Name="BuildProgress" Height="7" Minimum="0" Maximum="100" Foreground="{StaticResource Accent}" Background="#27334E" />
                        <Expander Header="Detalhes técnicos" Foreground="{StaticResource TextSecondary}" Margin="0,12,0,0">
                            <TextBox x:Name="LogTextBox" Height="130" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" FontFamily="Cascadia Mono,Consolas" FontSize="11" />
                        </Expander>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="2" Background="#0E1528" BorderBrush="{StaticResource CardBorder}" BorderThickness="0,1,0,0" Padding="32,18">
            <Grid>
                <TextBlock x:Name="FooterHint" Text="A ISO original nunca será alterada." Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Sobre" Background="#27334E" Margin="0,0,10,0" Click="About_Click" />
                    <Button x:Name="CancelButton" Content="Cancelar" Background="#3A465F" Margin="0,0,10,0" Visibility="Collapsed" Click="Cancel_Click" />
                    <Button x:Name="BuildButton" Content="Criar ISO modificada" Padding="24,11" Click="Build_Click" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
